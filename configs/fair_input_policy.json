{
  "version": "fair_input_policy_v1",
  "date": "2026-07-01",
  "global_inference_rules": {
    "single_image_only": true,
    "paired_reference_image_allowed": false,
    "cf_cs_label_allowed": false,
    "pair_metadata_allowed": false,
    "ground_truth_allowed": false,
    "evaluation_claim_fields_allowed": false,
    "cross_track_inputs_allowed": false
  },
  "tracks": {
    "qa": {
      "allowed_inputs": ["image", "qa_question"],
      "forbidden_inputs": [
        "mc_question",
        "mc_options",
        "caption_prompt",
        "gt_answer",
        "gt_caption",
        "critical_claim",
        "prior_claim",
        "shared_claims",
        "forbidden_claims",
        "subcategory",
        "pair_id_semantics",
        "cf_cs_label",
        "paired_reference_image"
      ]
    },
    "mc": {
      "allowed_inputs": ["image", "mc_question", "mc_options"],
      "forbidden_inputs": [
        "qa_question",
        "caption_prompt",
        "gt_answer",
        "gt_option",
        "gt_caption",
        "critical_claim",
        "prior_claim",
        "shared_claims",
        "forbidden_claims",
        "subcategory",
        "pair_id_semantics",
        "cf_cs_label",
        "paired_reference_image"
      ]
    },
    "caption": {
      "allowed_inputs": ["image", "caption_prompt"],

        "single_image_derived_segments_or_keypoints_for_internal_audit",
        "task_native_risk_family_prediction",
        "task_native_relation_or_asymmetry_audit",
        "self_generated_risk_scores_from_image_and_caption_prompt",
        "decoder_state_from_image_and_caption_prompt",
        "image_conditioned_logits_from_caption_prompt",
        "no_image_prior_logits_from_caption_prompt",
        "single_image_degraded_prior_logits_from_caption_prompt",
        "image_no_image_hidden_delta_from_caption_prompt",
        "image_degraded_hidden_delta_from_caption_prompt",
        "orthogonal_visual_residual_from_image_no_image_hidden_states",
        "orthogonal_visual_residual_from_image_degraded_hidden_states",
        "prior_logit_advantage_from_no_image_or_degraded_view",
        "jacobian_lens_or_logit_lens_readouts_from_caption_prompt",
        "workspace_layer_prior_concepts_from_model_internal_state",
        "prior_token_embedding_subspace_from_prior_source_topk",
        "final_hidden_prior_token_subspace_suppression",
        "layerwise_prior_token_subspace_suppression",
        "decoder_self_attention_prior_residual_from_prior_source",
        "layerwise_attention_prior_residual_suppression",
        "headwise_attention_prior_residual_suppression",
        "headwise_attention_visual_delta_boost",
        "pre_softmax_image_token_attention_reallocation",
        "pre_softmax_text_route_attention_suppression",
        "jspace_prior_concept_suppression",
        "jspace_visual_residual_injection",
        "latent_steered_logits_from_caption_prompt",
        "layerwise_hidden_residual_injection_from_image_no_image_hidden_states",
        "decoder_visual_attention_to_image_tokens"
      ],
      "forbidden_inputs": [
        "qa_question",
        "qa_answer",
        "mc_question",
        "mc_options",
        "mc_predictions",
        "gt_caption",
        "critical_claim",
        "prior_claim",
        "shared_claims",
        "forbidden_claims",
        "subcategory",
        "pair_id_semantics",
        "cf_cs_label",
        "paired_reference_image"
      ]
    },
    "external_hallucination_benchmark": {
      "allowed_inputs": ["image", "benchmark_native_prompt", "benchmark_native_options_if_any"],
      "forbidden_inputs": [
        "cdh_subcategory",
        "cdh_claim_fields",
        "cdh_gt_answer",
        "cdh_pair_metadata",
        "extra_reference_image",
        "cross_track_predictions"
      ]
    }
  },
  "calibration_and_analysis": {
    "subcategory_allowed_for_stratified_reporting": true,
    "subcategory_allowed_for_heldout_empirical_bayes_calibration": true,
    "subcategory_allowed_for_final_test_inference": false,
    "final_test_gate_rule": "A gate may use only task-native inputs at inference. If benchmark subcategory labels are used to switch a method on/off, report it as oracle_or_analysis_only rather than fair.",
    "text_only_judge_allowed_fields": [
      "focus_question",
      "gt_text",
      "critical_claim",
      "prior_claim",
      "shared_claims",
      "forbidden_claims",
      "model_output",
      "synonym_hints"
    ],
    "text_only_judge_image_allowed": false
  },
